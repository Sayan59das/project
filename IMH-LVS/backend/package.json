{
  "name": "imh-lvs-backend",
  "version": "0.1.0",
  "private": true,
  "description": "IMH LVS backend foundation — health check + label upload/validation scaffold for a future OCR/AI integration.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "node -r tsx/cjs --test src/**/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@tesseract.js-data/eng": "1.0.0",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "form-data": "^4.0.6",
    "multer": "^2.0.2",
    "pdfjs-dist": "^4.6.82",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.23.1",
    "prisma": "^8.0.0-rc.13",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
