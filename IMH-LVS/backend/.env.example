# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file — see backend/.gitignore.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (Postgres) ---
# REQUIRED for every route that reads or writes stored data. Label
# extraction (/api/labels/extract) is stateless and works without it, which
# is why the app still starts when this is unset — the failure surfaces on
# the first request that actually needs the database, not at boot.
#
# Local development runs Postgres in Docker:
#   docker run -d --name imh-lvs-pg -e POSTGRES_PASSWORD=lvsdev #     -e POSTGRES_USER=lvs -e POSTGRES_DB=imh_lvs -p 5433:5432 postgres:16-alpine
#   npm run db:migrate && npm run db:seed
#
# Port 5433 rather than the default 5432 so it cannot collide with a
# Postgres already installed on the host machine.
DATABASE_URL=postgres://lvs:lvsdev@localhost:5433/imh_lvs

# Hosted Postgres (Render, Neon, Supabase) requires TLS; local Docker
# Postgres has no certificate. Set true for hosted, false locally.
DATABASE_SSL=false

# Upper bound on pooled connections. Render's free Postgres plan caps
# concurrent connections in the low tens and this process is not the only
# client, so stay well under it.
# DATABASE_POOL_MAX=10

# --- CORS ---
# Origin(s) allowed to call this API. Comma-separate multiple values
# (e.g. local dev + the Vercel-deployed frontend).
FRONTEND_ORIGIN=http://localhost:4173

# --- Uploads ---
# Maximum accepted label file size, in megabytes.
MAX_UPLOAD_FILE_SIZE_MB=5

# --- OCR (open-source Tesseract, via tesseract.js) ---
# Label extraction (see src/services/labelExtraction.service.ts) runs
# entirely locally through Tesseract OCR — no external API or key needed.
# These are optional tuning knobs; sensible defaults are used if unset.

# A PDF text layer shorter than this many characters is treated as "no
# usable text" and the PDF is rasterized to images for OCR instead.
# PDF_MIN_TEXT_LENGTH=20

# Maximum number of pages of a scanned/image PDF that get rasterized and
# OCR'd per request.
# PDF_MAX_OCR_PAGES=5

# DPI used when rasterizing scanned PDF pages (via pdftoppm) before OCR.
# PDF_RASTER_DPI=300

# Verbose extraction debugging: logs the raw PDF/OCR text, the parsed
# fields, and the anchor/reason each field was (or wasn't) matched from.
# Off by default. Only turn this on temporarily while diagnosing a real
# label's extraction — it logs label file content to the console, which
# should never run enabled in a long-lived production deployment.
# LABEL_EXTRACTION_DEBUG=true

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# How long a session lasts from the moment it is issued. Absolute, not
# sliding — a sliding expiry on a system where reviewers keep a tab open all
# day never expires at all.
# SESSION_TTL_HOURS=8

# Set to true when the API and the frontend are on different SITES, which on
# Render they are (onrender.com is a public suffix, so two services under it
# are cross-site). It makes the session cookie SameSite=None; Secure, without
# which the browser drops it.
#
# Locally they differ only by port, which is NOT cross-site, so leave this
# unset — a Secure cookie over plain http is refused.
# SESSION_COOKIE_CROSS_SITE=false

# Applied to every seeded user by `npm run db:seed`. NO DEFAULT, on purpose:
# unset means the seeded accounts have no credential and cannot sign in, so a
# seed run against a real deployment cannot install a password that is public
# knowledge. For local work, the frontend prototype's mock password:
# SEED_USER_PASSWORD=password123
